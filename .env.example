# Frontend environment variables (Vite build). Copy to .env.local for local dev or .env.production for builds.
# Optional: overrides the contact form endpoint. Defaults to the live API Gateway endpoint in src/components/ContactForm.tsx.
VITE_CONTACT_ENDPOINT=

# Lambda environment variables (for lambda-contact/) are set in the AWS Console, not here:
#   ALLOW_ORIGIN (optional)
#   FROM_EMAIL
#   TO_EMAIL
