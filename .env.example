# Frontend environment variables (Vite build)
# Copy this file to .env.local for local dev, .env.production for prod builds.
# These are the only vars the frontend needs.

VITE_CONTACT_ENDPOINT=
VITE_STRIPE_ENDPOINT=

# Lambda environment variables are set in the AWS Console — NOT here.
# Required on each Lambda function:
#   STRIPE_SECRET_KEY
#   STRIPE_PRICE_ID
#   STRIPE_WEBHOOK_SECRET
#   FROM_EMAIL
#   TO_EMAIL
